  "cards": [
    {
      "dot": "emerald",
      "title": "Authoritative vs Derived Data",
      "items": [
        "Authoritative: Firebase RTDB vouchers, ledger closing balances, and stock movements",
        "Derived: Dexie local caches, GSTR reports, Trial Balance, and Dashboard KPI rollups",
        "Derived tables can be rebuilt deterministically from authoritative ledger transactions"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and Storage Boundaries",
      "items": [
        "Voucher Engine enforces integer paise double-entry balance and active FY checks",
        "Frozen Master Snapshots insulate historical documents from subsequent setting edits",
        "Binary PDF assets and signatures are stored in Cloudflare R2 object storage"
      ]
    },
    {
      "dot": "cyan",
      "title": "Realtime Propagation",
      "items": [
        "Firebase onValue listeners replicate cloud mutations into client Dexie tables",
        "Reactive useLive hooks update UI tables and charts without requiring full page reloads",
        "Deletions in RTDB are authoritatively reconciled by deleting matching local Dexie records"
      ]
    }
  ]
