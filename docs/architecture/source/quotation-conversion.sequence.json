    },
    {
      "id": "msg-post-gate",
      "from": "quote-ui",
      "to": "posting-svc",
      "y": 565,
      "label": "Trigger Authoritative Post",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Immutable Snapshot Rules",
      "items": [
        "Quotation line items, descriptions, and negotiated prices freeze upon conversion",
        "Original quotation ID is linked in invoice metadata for full traceability",
        "Future product master price changes do not mutate the agreed commercial snapshot"
      ]
    },
    {
      "dot": "amber",
      "title": "Mandatory Tax Recalculation",
      "items": [
        "Conversion triggers calculateCanonicalDocument to ensure HSN and tax slabs remain statutory",
        "Place of supply vs company state re-determines CGST+SGST vs IGST applicability",
        "Round-off differences are resolved deterministically before draft persistence"
      ]
    },
    {
      "dot": "cyan",
      "title": "Trust Boundary Transition",
      "items": [
        "Draft invoice exists safely in Dexie and RTDB without altering general ledger books",
        "No financial vouchers or stock deductions are committed in draft state",
        "Final promotion to posted ledger requires explicit employee execution through postingService"
      ]
    }
  ]
