      "variant": "emphasis"
    },
    {
      "id": "msg-freeze-snapshot",
      "from": "quote-ui",
      "to": "conversion-svc",
      "y": 220,
      "label": "Freeze Quotation Snapshot",
      "variant": "emphasis"
    },
    {
      "id": "msg-snapshot-ack",
      "from": "conversion-svc",
      "to": "quote-ui",
      "y": 275,
