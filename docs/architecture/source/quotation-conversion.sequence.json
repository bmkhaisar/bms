  "segments": [
    {
      "from": 145,
      "to": 290,
      "label": "Quotation Validation & Snapshot Freeze"
    },
    {
      "from": 300,
      "to": 440,
      "label": "Draft Generation & Canonical Tax Check"
    },
    {
      "from": 450,
      "to": 590,
      "label": "Draft Persistence & Posting Gate"
    }
  ],
  "messages": [
    {
      "id": "msg-convert-click",
      "from": "sales-rep",
      "to": "quote-ui",
      "y": 165,
