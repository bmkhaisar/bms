        "label": "Snapshot Freeze",
        "focus": ["sales-rep", "quote-ui", "conversion-svc"],
        "note": "Quotation prices, terms, and line items freeze into an immutable historical snapshot."
      },
      {
        "id": "canonical-tax-check",
        "label": "Canonical Tax Recalculation",
        "focus": ["conversion-svc", "tax-engine"],
        "note": "Tax engine recomputes GST rates and validates current fiscal rules before draft generation."
      },
      {
        "id": "draft-to-posting",
        "label": "Draft Persistence & Posting Gate",
        "focus": ["conversion-svc", "dexie-store", "rtdb", "posting-svc"],
        "note": "Draft is saved locally and mirrored before the trusted posting engine books GL vouchers."
      }
    ]
  },
  "participants": [
