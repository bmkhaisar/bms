    { "id": "quote-ui", "type": "frontend", "label": "Quote UI", "sublabel": "Quotation View" },
    { "id": "conversion-svc", "type": "backend", "label": "Conversion Svc", "sublabel": "Document Bridge" },
    { "id": "tax-engine", "type": "backend", "label": "Tax Engine", "sublabel": "Canonical Calc" },
    { "id": "dexie-store", "type": "database", "label": "Dexie DB", "sublabel": "Local Cache" },
    { "id": "rtdb", "type": "database", "label": "Firebase RTDB", "sublabel": "Cloud Truth" },
    { "id": "posting-svc", "type": "security", "label": "Posting Svc", "sublabel": "GL Gateway" }
