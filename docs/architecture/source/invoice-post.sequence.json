        "focus": ["user", "ui", "postingSvc", "taxEngine", "serverFn", "rtdb", "dexie", "realtime", "reports"],
        "note": "Follow invoice posting from client button click through server voucher creation and cross-device realtime broadcast."
      },
      {
        "id": "server-trust-gate",
        "label": "Server trust gate",
        "focus": ["postingSvc", "serverFn", "rtdb"],
        "note": "Isolate the authoritative Firebase Admin posting engine enforcing double-entry balance and voucher allocation."
      },
      {
        "id": "realtime-reconciliation",
        "label": "Realtime reconciliation",
        "focus": ["rtdb", "realtime", "dexie", "reports"],
        "note": "Trace how cloud operational updates synchronize into Dexie and re-render reactive useLive components."
      }
