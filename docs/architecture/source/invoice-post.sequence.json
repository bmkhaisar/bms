  "messages": [
    {
      "id": "msg-post-click",
      "from": "user",
      "to": "ui",
      "y": 160,
      "label": "Click Post Invoice",
      "variant": "emphasis"
    },
    {
      "id": "msg-post-dispatch",
      "from": "ui",
      "to": "postingSvc",
      "y": 190,
      "label": "postInvoiceTransaction(invoice)",
      "variant": "default"
    },
    {
      "id": "msg-tax-validate",
      "from": "postingSvc",
      "to": "taxEngine",
      "y": 220,
      "label": "validateDocumentTotals(invoice)",
      "variant": "default"
    },
    {
      "id": "msg-tax-return",
      "from": "taxEngine",
      "to": "postingSvc",
      "y": 250,
      "label": "authoritative totals + Rule 46 ok",
      "variant": "return"
    },
    {
      "id": "msg-server-fn",
      "from": "postingSvc",
      "to": "serverFn",
      "y": 285,
      "label": "postVoucherServerFn({ idToken, lines, mutationId })",
      "variant": "security"
    },
    {
      "id": "msg-rtdb-write",
      "from": "serverFn",
      "to": "rtdb",
      "y": 315,
      "label": "atomic multi-path write (vouchers + ledgers)",
      "variant": "security"
    },
    {
      "id": "msg-rtdb-ack",
      "from": "rtdb",
      "to": "serverFn",
      "y": 345,
      "label": "transaction committed",
      "variant": "return"
    },
    {
      "id": "msg-voucher-return",
      "from": "serverFn",
      "to": "postingSvc",
      "y": 372,
      "label": "voucherId + allocated sequence number",
      "variant": "return"
    },
    {
      "id": "msg-save-invoice-rtdb",
      "from": "postingSvc",
      "to": "rtdb",
      "y": 405,
      "label": "set(companyData/invoices/id, frozenInvoice)",
      "variant": "security"
    },
    {
      "id": "msg-put-dexie",
      "from": "postingSvc",
      "to": "dexie",
      "y": 435,
      "label": "db().invoices.put(updatedInvoice)",
      "variant": "default"
    },
    {
      "id": "msg-svc-return",
      "from": "postingSvc",
      "to": "ui",
      "y": 462,
      "label": "{ success: true, voucherId, invoice }",
      "variant": "return"
    },
    {
      "id": "msg-ui-toast",
      "from": "ui",
      "to": "user",
      "y": 488,
      "label": "render posted invoice + toast success",
      "variant": "return"
    },
    {
      "id": "msg-realtime-trigger",
      "from": "rtdb",
      "to": "realtime",
      "y": 520,
      "label": "onValue(companyData/invoices) fires",
      "variant": "dashed"
    },
    {
      "id": "msg-realtime-put",
      "from": "realtime",
      "to": "dexie",
      "y": 555,
      "label": "bulkPut(records) across peer devices",
      "variant": "default"
    },
    {
      "id": "msg-dexie-react",
      "from": "dexie",
      "to": "reports",
      "y": 590,
      "label": "useLive invalidates & refreshes AR report",
      "variant": "default"
    }
  ],
