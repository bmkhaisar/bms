  "cards": [
    {
      "dot": "emerald",
      "title": "Posting Invariants",
      "items": [
        "Client and server execute identical canonical tax calculation (PRD §§ 44-55)",
        "Tampered client totals are rejected if discrepancy exceeds floating roundoff tolerance",
        "Rule 46 statutory GST invoice number validation is enforced prior to voucher allocation"
      ]
    },
    {
      "dot": "rose",
      "title": "Idempotent Server Boundary",
      "items": [
        "Double-entry vouchers are allocated atomically by Firebase Admin server functions",
        "clientMutationId eliminates duplicate postings during network retries or double clicks",
        "RTDB security rules block direct client writes to vouchers and docCounters"
      ]
    },
    {
      "dot": "cyan",
      "title": "Fast Path & Multi-Device Sync",
      "items": [
        "Originating device updates local Dexie immediately upon server response for instant UX",
        "Realtime listener propagates cloud changes to peer devices without manual page reloads",
        "Frozen snapshots preserve company settings, signatory, and tax head configuration forever"
      ]
    }
  ]
