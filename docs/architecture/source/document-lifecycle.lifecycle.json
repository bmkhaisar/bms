  "cards": [
    {
      "dot": "emerald",
      "title": "Allowed Lifecycle Transitions",
      "items": [
        "Draft -> Posted: Authorized posting via postingService, creates double-entry GL vouchers + inventory journal",
        "Posted -> Partial / Paid: Customer receipts allocate against document invoiceId, updating AR balance",
        "Partial -> Paid: Subsequent receipts clear the remaining balance to zero",
        "Draft -> Cancelled / Void: Pre-commitment termination before any financial voucher is created",
        "Posted / Partial -> Reversed: Formal reversal via reversalEngine producing audited reversing GL vouchers"
      ]
    },
    {
      "dot": "rose",
      "title": "Strictly Forbidden Transitions",
      "items": [
        "Posted -> Draft: FORBIDDEN. Financial vouchers are immutable and cannot be rolled back to draft",
        "Cancelled -> Posted: FORBIDDEN. Cancelled drafts are terminated and cannot enter the GL",
        "Reversed -> Active / Draft: FORBIDDEN. Reversal is permanent and audit-sealed",
        "Draft -> Paid / Partial: FORBIDDEN. Unposted documents cannot receive ledger payments"
      ]
    }
