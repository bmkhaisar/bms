  "cards": [
    {
      "dot": "emerald",
      "title": "Authoritative Flow",
      "items": [
        "UI triggers document posting through preflight validation in Posting Service",
        "Double-entry journal vouchers and stock ledger movements execute exclusively on Trusted Server",
        "Firebase RTDB is the single cloud authority; database rules strictly deny client writes to vouchers and audit logs"
      ]
    },
    {
      "dot": "rose",
      "title": "Financial Trust Boundary",
      "items": [
        "Financial vouchers cannot be fabricated directly by the frontend or Dexie cache",
        "Idempotency is enforced on the server using stable clientMutationId keys",
        "Reversals create exact balanced counter-vouchers; history is never deleted"
      ]
    },
    {
      "dot": "cyan",
      "title": "Local-First Realtime Sync",
      "items": [
        "Dexie bms_db_v1 provides instant zero-latency UI reads via useLive reactive hooks",
        "companyRealtimeSync reconciles cloud deletions and updates across all devices without page reloads",
        "Immutable snapshots freeze company settings, signatories, and tax profiles upon issuance"
      ]
    }
  ]
